# copy to .env and adjust if needed. compose reads this file automatically.
POSTGRES_USER=uptime
POSTGRES_PASSWORD=uptime
POSTGRES_DB=uptime

# how often every site gets checked, in seconds
CHECK_INTERVAL_SECONDS=60
# how long the worker waits for a site before calling it down
HTTP_TIMEOUT_SECONDS=10

# host port for the board. kind uses 8081 and 8082, so compose keeps 8080
WEB_PORT=8080
